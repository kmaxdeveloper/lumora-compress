<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        app:elevation="0dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="48dp"
            android:paddingHorizontal="@dimen/spacing_24"
            android:paddingBottom="@dimen/spacing_24">

            <TextView
                android:id="@+id/tvGreeting"
                style="@style/TextAppearance.Lumora.BodyLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.7"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:text="Good Morning" />

            <TextView
                android:id="@+id/tvAppTitle"
                style="@style/TextAppearance.Lumora.HeadlineSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tvGreeting" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/ivAvatar"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@mipmap/ic_launcher_round"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumora.Medium" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShareApp"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="@dimen/spacing_8"
                app:icon="@drawable/ic_share"
                app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
                app:layout_constraintEnd_toStartOf="@+id/ivAvatar"
                app:layout_constraintTop_toTopOf="@+id/ivAvatar" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/spacing_32">

            <!-- Quick Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/spacing_16">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCompress"
                    style="@style/Widget.Lumora.Card"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_margin="@dimen/spacing_8"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorPrimaryContainer"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumora.ExtraLarge">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:contentDescription="@null"
                            android:src="@drawable/image_compress"
                            app:tint="?attr/colorOnPrimaryContainer" />

                        <TextView
                            style="@style/TextAppearance.Lumora.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_12"
                            android:text="@string/btn_compress"
                            android:textColor="?attr/colorOnPrimaryContainer" />
                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardBatch"
                    style="@style/Widget.Lumora.Card"
                    android:layout_width="0dp"
                    android:layout_height="180dp"
                    android:layout_margin="@dimen/spacing_8"
                    android:layout_weight="1"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumora.ExtraLarge">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:contentDescription="@null"
                                android:src="@drawable/image_batch_processing" />

                            <TextView
                                style="@style/TextAppearance.Lumora.TitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12"
                                android:text="@string/btn_batch"
                                android:textColor="?attr/colorOnSecondaryContainer" />
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/ivBatchLock"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="top|end"
                            android:layout_margin="12dp"
                            android:src="@drawable/image_lock"
                            android:contentDescription="@null" />

                        <TextView
                            android:id="@+id/tvBatchLimit"
                            style="@style/TextAppearance.Lumora.LabelSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom|center_horizontal"
                            android:layout_marginBottom="16dp"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:alpha="0.8"
                            tools:text="3 left" />
                    </FrameLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Statistics -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lumora.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_24"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_16">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvStatCount" style="@style/TextAppearance.Lumora.TitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" tools:text="42" />
                        <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/images" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvStatSaved" style="@style/TextAppearance.Lumora.TitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" tools:text="1.2 GB" />
                        <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/saved" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">
                        <TextView android:id="@+id/tvStatReduction" style="@style/TextAppearance.Lumora.TitleLarge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" tools:text="65%" />
                        <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/reduction" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                    </LinearLayout>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Storage Guardian Entry -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStorageGuardian"
                style="@style/Widget.Lumora.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_24"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/spacing_16">

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/image_guardian" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/spacing_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.Lumora.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storage_guardian"
                            android:textColor="?attr/colorOnSecondaryContainer" />

                        <TextView
                            style="@style/TextAppearance.Lumora.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/storage_guardian_desc"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:alpha="0.7" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="?attr/colorOnSecondaryContainer" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <uz.kmax.compress.common.widget.NativeAdComponent
                android:id="@+id/nativeAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <uz.kmax.compress.common.widget.YandexNativeAdComponent
                android:id="@+id/yandexNativeAd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!-- Recent Files Section -->
            <uz.kmax.compress.common.widget.SectionHeaderView
                android:id="@+id/headerRecent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:paddingHorizontal="@dimen/spacing_24" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvRecentFiles"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:overScrollMode="never"
                tools:itemCount="3"
                tools:listitem="@layout/item_recent_file" />

            <uz.kmax.compress.common.widget.EmptyStateView
                android:id="@+id/emptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Premium Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPremium"
                style="@style/Widget.Lumora.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/spacing_24"
                android:layout_marginTop="@dimen/spacing_16"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="@dimen/spacing_16">

                    <TextView
                        android:id="@+id/tvPremiumTitle"
                        style="@style/TextAppearance.Lumora.TitleMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlock_full_potential"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        style="@style/TextAppearance.Lumora.BodySmall"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/unlimited_batch_desc"
                        android:textColor="?attr/colorOnSecondaryContainer"
                        android:alpha="0.7"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvPremiumTitle" />

                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:src="@drawable/app_logo"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
