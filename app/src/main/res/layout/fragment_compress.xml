<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            style="@style/Widget.Lumora.Toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_back"
            app:title="@string/compress_image"
            app:titleCentered="true" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="140dp"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/spacing_16"
            android:paddingTop="@dimen/spacing_8">

            <!-- Premium Header Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/Widget.Lumora.Card"
                app:cardElevation="4dp"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.Lumora.ExtraLarge">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/ivPreview"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:adjustViewBounds="true"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/compress_image"
                        app:layout_constraintDimensionRatio="16:9"
                        app:layout_constraintTop_toTopOf="parent"
                        tools:src="@mipmap/ic_launcher" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:background="@drawable/bg_gradient_scrim"
                        app:layout_constraintBottom_toBottomOf="@+id/ivPreview" />

                    <TextView
                        android:id="@+id/tvImageInfo"
                        style="@style/TextAppearance.Lumora.LabelMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/spacing_16"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="@+id/ivPreview"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:text="4000x3000 • 2.5 MB • JPEG" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Mode Selector: Premium Experience -->
            <TextView
                style="@style/TextAppearance.Lumora.TitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_24"
                android:layout_marginStart="@dimen/spacing_4"
                android:text="@string/compression_mode"
                android:alpha="0.6"
                android:letterSpacing="0.1" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_12">

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggleMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:checkedButton="@+id/btnSmart"
                    app:layout_constraintTop_toTopOf="parent"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSmart"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="@string/smart"
                        android:textSize="11sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        app:icon="@drawable/image_guardian"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        tools:text="Smart" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnManual"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="@string/manual_compression"
                        android:textSize="11sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        app:icon="@drawable/ic_settings"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        tools:text="Manual" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSocial"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="@string/social_media"
                        android:textSize="11sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        app:icon="@drawable/ic_favorite_border"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        tools:text="Social" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTargetSize"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="80dp"
                        android:layout_weight="1"
                        android:text="@string/target"
                        android:textSize="11sp"
                        android:paddingTop="12dp"
                        android:paddingBottom="8dp"
                        app:icon="@drawable/image_size"
                        app:iconGravity="top"
                        app:iconPadding="4dp"
                        tools:text="Target" />

                </com.google.android.material.button.MaterialButtonToggleGroup>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardTargetLock"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="6dp"
                    app:cardBackgroundColor="?attr/colorSurface"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="6dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toTopOf="@+id/toggleMode"
                    app:layout_constraintEnd_toEndOf="@+id/toggleMode">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_gravity="center"
                        android:src="@drawable/image_lock"
                        android:contentDescription="@null"
                        app:tint="?attr/colorOnSurfaceVariant" />

                </com.google.android.material.card.MaterialCardView>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <!-- Mode Specific Content -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_16">

                <!-- Smart Info Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSmartInfo"
                    style="@style/Widget.Lumora.Card.Filled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="?attr/colorSecondaryContainer"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_20">

                        <TextView
                            android:id="@+id/tvSmartReason"
                            style="@style/TextAppearance.Lumora.TitleMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            tools:text="Optimal for Portraits" />

                        <TextView
                            android:id="@+id/tvSmartDetails"
                            style="@style/TextAppearance.Lumora.BodyMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_4"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            android:alpha="0.8"
                            tools:text="WEBP • 80% • Resize 90%" />

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/spacing_12"
                            app:dividerColor="?attr/colorOnSecondaryContainer"
                            android:alpha="0.1" />

                        <TextView
                            android:id="@+id/tvSmartQuality"
                            style="@style/TextAppearance.Lumora.LabelLarge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="?attr/colorOnSecondaryContainer"
                            tools:text="Preserved quality: 92/100" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Social Presets -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/socialPresetsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_social_preset" />

                <!-- Target Size Experience -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/targetSizeCard"
                    style="@style/Widget.Lumora.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/spacing_20">

                        <TextView
                            style="@style/TextAppearance.Lumora.TitleMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/target_size"
                            android:textStyle="bold" />

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/targetSizeChips"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_12"
                            app:singleSelection="true">
                            <com.google.android.material.chip.Chip android:id="@+id/target100" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="100 KB" />
                            <com.google.android.material.chip.Chip android:id="@+id/target200" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="200 KB" />
                            <com.google.android.material.chip.Chip android:id="@+id/target500" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="500 KB" />
                            <com.google.android.material.chip.Chip android:id="@+id/target1mb" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1 MB" />
                            <com.google.android.material.chip.Chip android:id="@+id/targetCustom" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/custom" />
                        </com.google.android.material.chip.ChipGroup>

                        <LinearLayout
                            android:id="@+id/layoutTargetStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/spacing_20"
                            android:orientation="vertical"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <com.google.android.material.progressindicator.LinearProgressIndicator
                                android:id="@+id/targetIterationProgress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:max="8"
                                tools:progress="3" />

                            <TextView
                                android:id="@+id/targetProgress"
                                style="@style/TextAppearance.Lumora.BodySmall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:textAlignment="center"
                                tools:text="Iteration 3 / 8 • 450 KB" />

                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Manual Settings (Grouped in Cards) -->
                <LinearLayout
                    android:id="@+id/layoutManualSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Quality Card -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Lumora.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_20">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView style="@style/TextAppearance.Lumora.TitleMedium" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/quality" android:textStyle="bold" />
                                <TextView android:id="@+id/tvCurrentQuality" style="@style/TextAppearance.Lumora.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorPrimary" android:textStyle="bold" tools:text="80%" />
                            </LinearLayout>

                            <com.google.android.material.slider.Slider
                                android:id="@+id/sliderQuality"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_8"
                                android:value="80"
                                android:valueFrom="1"
                                android:valueTo="100"
                                app:labelBehavior="gone" />

                            <com.google.android.material.chip.ChipGroup
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                app:singleSelection="true">
                                <com.google.android.material.chip.Chip android:id="@+id/chipLow" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/low" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipMedium" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/medium" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipHigh" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/high" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipMaximum" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/max" />
                            </com.google.android.material.chip.ChipGroup>

                            <TextView
                                android:id="@+id/tvQualityWarning"
                                style="@style/TextAppearance.Lumora.LabelSmall"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12"
                                android:alpha="0.6"
                                android:textAlignment="center"
                                tools:text="Good balance between size and quality" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>


                    <!-- Format Card -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Lumora.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_20">

                            <TextView
                                style="@style/TextAppearance.Lumora.TitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/output_format"
                                android:textStyle="bold" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupFormat"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12"
                                app:singleSelection="true"
                                app:selectionRequired="true">
                                <com.google.android.material.chip.Chip android:id="@+id/chipAuto" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/auto" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipJpeg" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/jpeg" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipPng" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/png" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipWebp" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/webp" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipAvif" style="@style/Widget.Material3.Chip.Filter" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/avif" app:closeIconVisible="true" app:closeIcon="@drawable/image_lock" />
                            </com.google.android.material.chip.ChipGroup>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <!-- Advanced Card -->
                    <com.google.android.material.card.MaterialCardView
                        style="@style/Widget.Lumora.Card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/spacing_16">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/spacing_20">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                                <TextView style="@style/TextAppearance.Lumora.TitleMedium" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/resize" android:textStyle="bold" />
                                <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switchResize" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                            </LinearLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/layoutResizeOptions"
                                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12"
                                android:hint="Max Resolution (px)"
                                android:visibility="gone">
                                <com.google.android.material.textfield.TextInputEditText android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.divider.MaterialDivider
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/spacing_16" />

                            <TextView
                                style="@style/TextAppearance.Lumora.TitleMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/metadata"
                                android:textStyle="bold" />

                            <com.google.android.material.chip.ChipGroup
                                android:id="@+id/chipGroupMetadata"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/spacing_12"
                                app:singleSelection="true"
                                app:selectionRequired="true">
                                <com.google.android.material.chip.Chip android:id="@+id/chipKeepMetadata" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/keep_metadata" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipRemoveGps" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remove_gps" />
                                <com.google.android.material.chip.Chip android:id="@+id/chipRemoveAll" style="@style/Widget.Material3.Chip.Suggestion" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/remove_all" />
                            </com.google.android.material.chip.ChipGroup>
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </FrameLayout>

            <!-- Premium Statistics Section -->
            <TextView
                style="@style/TextAppearance.Lumora.TitleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_32"
                android:layout_marginStart="@dimen/spacing_4"
                android:text="@string/estimated_result"
                android:alpha="0.6"
                android:letterSpacing="0.1" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.Lumora.Card.Filled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                app:cardBackgroundColor="?attr/colorSecondaryContainer">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/spacing_24">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/estimated_size" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                            <TextView android:id="@+id/tvEstimatedSize" style="@style/TextAppearance.Lumora.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" android:textStyle="bold" tools:text="450 KB" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/saved_space" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                            <TextView android:id="@+id/tvSavedSpace" style="@style/TextAppearance.Lumora.HeadlineSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" android:textStyle="bold" tools:text="-82%" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.divider.MaterialDivider
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="@dimen/spacing_16"
                        app:dividerColor="?attr/colorOnSecondaryContainer"
                        android:alpha="0.1" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:baselineAligned="false">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/format" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                            <TextView android:id="@+id/tvTargetFormat" style="@style/TextAppearance.Lumora.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" tools:text="WEBP" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">
                            <TextView style="@style/TextAppearance.Lumora.LabelSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/estimated_time" android:textColor="?attr/colorOnSecondaryContainer" android:alpha="0.7" />
                            <TextView android:id="@+id/tvEstimatedTime" style="@style/TextAppearance.Lumora.TitleMedium" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="?attr/colorOnSecondaryContainer" tools:text="~0.5s" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Bottom Actions -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        app:cardElevation="16dp"
        app:cardCornerRadius="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/spacing_16">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCompress"
                style="@style/Widget.Lumora.Button"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:text="@string/btn_compress"
                app:cornerRadius="@dimen/radius_16" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/compressProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/spacing_8"
                android:indeterminate="true"
                android:visibility="gone" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

