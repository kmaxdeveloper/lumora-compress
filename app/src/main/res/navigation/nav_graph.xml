<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <action
        android:id="@+id/action_global_premiumFragment"
        app:destination="@id/premiumFragment" />

    <fragment
        android:id="@+id/splashFragment"
        android:name="uz.kmax.compress.feature.splash.fragment.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_onboardingFragment"
            app:destination="@id/onboardingFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/onboardingFragment"
        android:name="uz.kmax.compress.feature.onboarding.fragment.OnboardingFragment"
        android:label="Onboarding"
        tools:layout="@layout/fragment_onboarding">
        <action
            android:id="@+id/action_onboardingFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/onboardingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="uz.kmax.compress.feature.home.fragment.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_galleryFragment"
            app:destination="@id/galleryFragment" />
        <action
            android:id="@+id/action_homeFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
        <action
            android:id="@+id/action_homeFragment_to_premiumFragment"
            app:destination="@id/premiumFragment" />
        <action
            android:id="@+id/action_homeFragment_to_aboutFragment"
            app:destination="@id/aboutFragment" />
        <action
            android:id="@+id/action_homeFragment_to_historyFragment"
            app:destination="@id/historyFragment" />
        <action
            android:id="@+id/action_homeFragment_to_batchFragment"
            app:destination="@id/batchFragment" />
        <action
            android:id="@+id/action_homeFragment_to_storageGuardianFragment"
            app:destination="@id/storageGuardianFragment" />
    </fragment>

    <fragment
        android:id="@+id/storageGuardianFragment"
        android:name="uz.kmax.compress.feature.guardian.fragment.StorageGuardianFragment"
        android:label="Storage Guardian"
        tools:layout="@layout/fragment_storage_guardian">
        <action
            android:id="@+id/action_storageGuardianFragment_to_batchFragment"
            app:destination="@id/batchFragment" />
        <action
            android:id="@+id/action_storageGuardianFragment_to_galleryFragment"
            app:destination="@id/galleryFragment" />
    </fragment>

    <fragment
        android:id="@+id/galleryFragment"
        android:name="uz.kmax.compress.feature.gallery.fragment.GalleryFragment"
        android:label="Gallery"
        tools:layout="@layout/fragment_gallery">
        <action
            android:id="@+id/action_galleryFragment_to_predictionFragment"
            app:destination="@id/predictionFragment" />
        <action
            android:id="@+id/action_galleryFragment_to_batchFragment"
            app:destination="@id/batchFragment" />
        <action
            android:id="@+id/action_galleryFragment_to_settingsFragment"
            app:destination="@id/settingsFragment" />
    </fragment>

    <fragment
        android:id="@+id/batchFragment"
        android:name="uz.kmax.compress.feature.batch.fragment.BatchFragment"
        android:label="Batch"
        tools:layout="@layout/fragment_batch">
        <argument
            android:name="batchId"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
        <argument
            android:name="categoryType"
            app:argType="string"
            app:nullable="true"
            android:defaultValue="@null" />
    </fragment>

    <fragment
        android:id="@+id/predictionFragment"
        android:name="uz.kmax.compress.feature.dashboard.fragment.PredictionFragment"
        android:label="Compression Intelligence"
        tools:layout="@layout/fragment_prediction">
        <argument android:name="imageModel" app:argType="uz.kmax.compress.feature.gallery.model.GalleryImageUiModel" />
        <action
            android:id="@+id/action_predictionFragment_to_compressFragment"
            app:destination="@id/compressFragment"
            app:popUpTo="@id/predictionFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/compressFragment"
        android:name="uz.kmax.compress.feature.compress.fragment.CompressFragment"
        android:label="Compress"
        tools:layout="@layout/fragment_compress">
        <argument
            android:name="imageModel"
            app:argType="uz.kmax.compress.feature.gallery.model.GalleryImageUiModel" />
        <action
            android:id="@+id/action_compressFragment_to_compareFragment"
            app:destination="@id/compareFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="false" />
    </fragment>

    <fragment
        android:id="@+id/compareFragment"
        android:name="uz.kmax.compress.feature.compare.fragment.CompareFragment"
        android:label="Compare"
        tools:layout="@layout/fragment_compare">
        <argument
            android:name="compareResult"
            app:argType="uz.kmax.compress.feature.compare.model.CompareResultUiModel" />
    </fragment>

    <fragment
        android:id="@+id/historyFragment"
        android:name="uz.kmax.compress.feature.history.fragment.HistoryFragment"
        android:label="History"
        tools:layout="@layout/fragment_history" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="uz.kmax.compress.feature.settings.fragment.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/premiumFragment"
        android:name="uz.kmax.compress.feature.premium.fragment.PremiumFragment"
        android:label="Premium"
        tools:layout="@layout/fragment_premium" />

    <fragment
        android:id="@+id/aboutFragment"
        android:name="uz.kmax.compress.feature.about.fragment.AboutFragment"
        android:label="About"
        tools:layout="@layout/fragment_about" />

</navigation>
